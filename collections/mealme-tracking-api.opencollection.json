{
  "opencollection": "1.0.0",
  "info": {
    "name": "MealMe Food Ordering Carts Tracking API",
    "version": "4.1.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "Authorization",
      "value": "{{Authorization}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Tracking",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Add a Tracking Webhook",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.mealme.ai/account/tracking/add_webhook",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Register a webhook to receive order tracking updates."
        }
      ]
    }
  ],
  "bundled": true
}