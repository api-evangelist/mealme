{
  "opencollection": "1.0.0",
  "info": {
    "name": "MealMe Food Ordering Carts Payments API",
    "version": "4.1.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "Authorization",
      "value": "{{Authorization}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Payments",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Create a Payment Method",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.mealme.ai/payment/create/v2",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Create a payment method for a user."
        },
        {
          "info": {
            "name": "List Payment Methods",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.mealme.ai/payment/list",
            "params": [
              {
                "name": "user_id",
                "value": "user_abc123",
                "type": "query"
              },
              {
                "name": "user_email",
                "value": "diner@example.com",
                "type": "query"
              }
            ]
          },
          "docs": "List a user's payment methods."
        },
        {
          "info": {
            "name": "Delete a Payment Method",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.mealme.ai/payment/delete",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Delete a user's payment method."
        },
        {
          "info": {
            "name": "Get a Payment Intent",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.mealme.ai/get_payment_intent",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Create a payment intent for a cart."
        }
      ]
    }
  ],
  "bundled": true
}